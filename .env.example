# ─── Server ───────────────────────────────────────────
PORT=3001
ALLOWED_ORIGINS=https://your-site.pages.dev,http://localhost:5500

# ─── Firebase Admin SDK ───────────────────────────────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
# Alternative to the five vars above: the whole service-account JSON file,
# raw or base64-encoded (wins when set).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# ─── Razorpay ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ─── Razorpay Webhook Secret ──────────────────────────
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Cloudflare R2 (product images) ──────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=jasa-product-images
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Customer files (routes/files.js) — PRIVATE R2 bucket, moved off Supabase 2026-11-21.
# R2 API token with Object Read & Write on this bucket only (server only, never in the browser).
R2_FILES_BUCKET=omx-customer-files
R2_FILES_ACCESS_KEY_ID=your_files_token_access_key_id
R2_FILES_SECRET_ACCESS_KEY=your_files_token_secret
# FILE_LINK_BASE=https://tujxcpohmnprbxoyiyat.supabase.co   # stored links keep this form (ID only)
